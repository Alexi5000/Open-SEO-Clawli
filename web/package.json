{
  "name": "open-seo-landing",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/generate-sitemap.js && node scripts/generate-social-cards.js",
    "build:app": "vite build",
    "sitemap": "node scripts/generate-sitemap.js",
    "start": "wrangler dev",
    "preview": "vite preview",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "deploy": "VITE_REQUIRE_TURNSTILE=1 npm run build && wrangler deploy",
    "deploy:prod": "VITE_REQUIRE_TURNSTILE=1 npm run build && wrangler deploy",
    "deploy:preview": "CLOUDFLARE_ENV=preview VITE_REQUIRE_TURNSTILE=1 npm run build && wrangler deploy",
    "test:protection": "vitest run && node scripts/check-free-tool-budget.cjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.60",
    "fumadocs-core": "^16.15.8",
    "fumadocs-mdx": "^13.0.8",
    "fumadocs-ui": "^16.15.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.7",
    "zod": "^4.6.7",
    "@radix-ui/react-popover": "^1.1.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.9",
    "srvx": "^0.11.22",
    "tailwindcss": "^4.3.3",
    "takumi-js": "2.13.7",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12",
    "wrangler": "^4.149.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2",
      "source-map-js": "1.2.2",
      "undici@7": "7.30.1"
    }
  }
}
